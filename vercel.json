{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.wander-it.be" }],
      "destination": "https://wander-it.be/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.wander-it.be" }],
      "destination": "https://wander-it.be/:path*",
      "permanent": true
    }
  ]
}
